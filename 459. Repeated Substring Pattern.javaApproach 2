class Solution {
    public boolean repeatedSubstringPattern(String s) {
        int n = s.length();
        for (int len = 1; len <= n / 2; len++) {
            if (n % len == 0) {
                String sub = s.substring(0, len);
                String temp = s.replace(sub, "");
                if (temp.length() == 0)
                    return true;
            }
        }
        return false;
    }
}
